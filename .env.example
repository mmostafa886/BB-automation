# ─── Environment Selection ───────────────────────────────────────────────────
# Controls which base URL and credentials are used across all tests.
# Valid values: "test" | "staging"
#
ENV=test

# ─── Winston Log Level ────────────────────────────────────────────────────────
# Controls verbosity of Winston log output (console + file + HTML report).
# Valid values (lowest → highest): silly | debug | verbose | info | warn | error
# Default if omitted: debug
#
LOG_LEVEL=debug

# ─── ReportPortal Integration (optional) ─────────────────────────────────────
# Required only if you enable the ReportPortal reporter in playwright.config.ts.
# To activate: uncomment the reporter line in playwright.config.ts and set your key.
#
RP_API_KEY=

# ─── AI Provider Keys ────────────────────────────────────────────────────────
# Set whichever provider you intend to use for self-healing / TC generation.
# Uncomment the relevant block and fill in your key.
#
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ─── Jira ─────────────────────────────────────────────────────────────────────
# Used by Jira pipeline skills to read/write issues.
# Authentication: Jira Cloud uses email + API token (Basic auth).
# Generate your API token at: https://id.atlassian.com/manage-profile/security/api-tokens
#
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=BB
JIRA_TC_ISSUE_TYPE=Task
JIRA_US_ISSUE_TYPE=Story

# ─── Application Settings ─────────────────────────────────────────────────────
REPO_PATH=./
POLL_INTERVAL=60000
TEST_DIRECTORY=./tests/generated
BASE_BRANCH=main

# ─── MCP Browser Snapshots (Generation-time) ─────────────────────────────────
# Set to "true" ONLY when the target application is running and accessible at
# BASE_URL. When true, the generator launches a headless browser via Playwright
# MCP, navigates to each module page, and captures an ARIA accessibility-tree
# snapshot to inject real page structure into AI prompts.
# When false, empty, or omitted → generation uses text-only prompts (default).
#
APP_IN_OPERATION=false
