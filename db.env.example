# ─── PostgreSQL Database ──────────────────────────────────────────────────────
# Copy this file to db.env and fill in real values.
# db.env is gitignored — never commit it.
#
# Used by: src/utils/db-helper.ts (loaded automatically on first DbHelper instantiation)

DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Set to "true" to enable SSL (e.g. for cloud-hosted Postgres)
DB_SSL=false

# Connection pool size — defaults are fine for test cleanup workloads
DB_POOL_MIN=1
DB_POOL_MAX=5
