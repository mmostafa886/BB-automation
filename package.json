{
  "name": "qa-automation-agent",
  "version": "1.0.0",
  "description": "Automated QA agent for Jira to Playwright TypeScript conversion",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "sync": "tsx src/scripts/manual-sync.ts",
    "test": "playwright test",
    "test:changed": "tsx src/executeTests.ts",
    "test:area": "tsx src/scripts/run-tests-for-area.ts",
    "test:module": "playwright test tests/generated/${MODULE}",
    "modules:list": "tsx src/scripts/list-modules.ts",
    "report": "playwright show-report",
    "auth:reset": "node -e \"['playwright-auth.json','session-storage.json'].forEach(f=>{try{require('fs').rmSync(f);console.log('Deleted '+f);}catch{}});try{require('fs').rmSync('.playwright-profile',{recursive:true});console.log('Deleted .playwright-profile/');}catch{} console.log('\\nAuth state cleared. Run: npm test');\"",
    "locators:extract": "node src/scripts/extract-locators.js",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install --with-deps",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "qa",
    "automation",
    "playwright",
    "jira",
    "openai",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/mcp": "^0.0.78",
    "@types/pg": "^8.20.0",
    "jira.js": "^3.0.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.4.2",
    "node-cron": "^3.0.3",
    "openai": "^4.67.3",
    "pg": "^8.22.0",
    "playwright": "1.62.0",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
